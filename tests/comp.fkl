(define (second $$ line)
  (vector-ref $$ 1))

(define parser
  (make-parser 'S
    'S #[ "#comp" .. #[?raw-string "^"] ] second
    'S #[ "#comp" #[?raw-string "^"] ] (lambda ($$ line) :empty)

    :ignore #[ :regex #r""\s+""]
  ))

(prin1n (parse "#comp^tag^abcd^tag^" parser))
(prin1n (parse "#comp ^tag^tabc^tag^" parser))

(defmacro #&comp
  comp :s-exp -> "#comp" .. #[?raw-string "^"] => builtin second
              -> "#comp" #[?raw-string "^"] => replace :empty)

(prin1n #comp^tag^abcd^tag^)
(prin1n #comp ^tag^tabc^tag^)
