(import ../make-test)

(define msg-pair
  (make-test
    _handle
    _dns
    _process
    _pipe
    _tcp
    _udp
    _fs
    _misc))

(define msg-vec (car msg-pair))
(define msgs (vector->list msg-vec))

(when (memp car msgs)
  (define errmsg "")
  (foreach (lambda (m)
             (setq errmsg
               (append errmsg
                       (format "\n\t%s" (cdr m)))))
           msgs)
  (throw 'fuv-error
         errmsg))
