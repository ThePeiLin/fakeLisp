(defmacro #&json
  json :s-exp -> "#json'" json-value => builtin second
  json-value -> :keyword "null"           => replace null
             -> :keyword "true"           => replace true
             -> :keyword "false"          => replace false
             -> *string*                  => builtin first
             -> *integer*                 => builtin first
             -> *float*                   => builtin first
             -> "{" json-object-items "}" => builtin hashequal
             -> "[" json-array-items  "]" => builtin vector
  json-object-item  -> *string* ":" json-value => builtin pair
  json-object-items -> => builtin nil
                    -> json-object-item => builtin cons
                    -> json-object-item "," json-object-items => builtin pair
  json-array-items  -> => builtin nil
                    -> json-value => builtin cons
                    -> json-value "," json-array-items => builtin pair)

(prin1n #json'{"foo":1,"bar":2,})

(prin1n #json'["foo","bar",null,true,false])

(defmacro #&other
  ;; 添加更多的分割符
  :delim "“" "”"
  :s-exp -> "#4th'" *s-exp* *s-exp* *s-exp* *s-exp*    => simple #(nth 4)
         -> "#23cons'" *s-exp* *s-exp* *s-exp* *s-exp* => simple #(cons 3 4)
         -> "#head'" *s-exp* *s-exp*                   => simple #(head head 1 2)
         -> "#2nd-vector'" *s-exp* *s-exp*             => simple #(vector 2)
         -> #(?symbol "《" "》")                       => simple #(symbol 0 "《" "》")
         -> :regex #r"/"“”|^“(\\.|.)*”$"/"             => simple #(string 0 "“" "”")
         -> "#other-json'" json/json-value             => builtin second
         -> :keyword "var" *symbol* :keyword "=" *s-exp*       => simple #(head define 1 3))

(prin1n '#4th' foo bar foobar barfoo)

(prin1n '#23cons' foo bar foobar barfoo)

(prin1n '#head' foo bar)

(prin1n '#2nd-vector' (foo bar) (foobar barfoo))

(prin1n '《测试》)

(prin1n '“测试”)

(prin1n #other-json'["foo","bar",null,true,false])

var foo = 114514

(println foo)
