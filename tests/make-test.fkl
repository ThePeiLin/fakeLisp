(export
  (defmacro ~(make-test,~rest)
    (let [(msg (make-symbol "msg"))
          (err-count (make-symbol "err-count"))]
    (if rest
      `(let [(~msg (make-vector ~(length rest) ()))
             (~err-count 0)]
         ~@(local
             (define num 0)
             (map (lambda (t)
                    (define tt (string->symbol (append "./" (symbol->string t))))
                    (define r
                      `(local
                         (define test-num ~num)
                         (let [(err (pcall (lambda () (import (only ~tt)))))]
                           (if (error? err)
                             (begin
                               (vector-set! ~msg
                                            test-num
                                            (cons err
                                                  (format "test-%S<%S> failed: %S: %s"
                                                          test-num
                                                          (quote ~t)
                                                          (error-type err)
                                                          (error-msg err))))
                               (setq ~err-count (1+ ~err-count)))
                             (vector-set! ~msg
                                          test-num
                                          (cons ()
                                                (format "test-%S<%S> success"
                                                        test-num
                                                        (quote ~t)))))
                           (newline))))
                    (setq num (1+ num))
                    r)
                  rest))
        (cons ~msg ~err-count))
      `()))))
