(export
  (defmacro #&custom
    custom-quote :s-exp -> "#quote'" *s-exp* => custom (list 'quote $1)
  ))

(export
  (defmacro #&comment
    :ignore :regex #r"/"/\*\*/|/\*.*\*/"/"
    :delim "/*"))

