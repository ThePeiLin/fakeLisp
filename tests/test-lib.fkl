;; :ignore <ignores>
;; :delim <delims> [<strings>...]
;; <符号> [:s-exp] -> <syms> => builtin/simple/custom/replace <action>
;;        [-> ...]
;; :s-exp -> <syms> => builtin/simple/custom/replace <action>
;;        [-> ...]

;; S -> prod
;;   -> ignore
;;   -> delim
;;
;; prod -> :s-exp          '-> symbol-seq '=> action-type action
;;      -> <symbol>        '-> symbol-seq '=> action-type action
;;      -> <symbol> :s-exp '-> symbol-seq '=> action-type action
;;
;; action      -> *s-exp*
;; action-type -> 'builtin
;;             -> 'simple
;;             -> 'custom
;;             -> 'replace
;;
;; ignore -> :ignore ignore-seq
;; delim  -> :delim  delimiters
;;
;; symbol-seq -> <epsilon>
;;            -> grammer-sym symbol-seq
;;
;; delimiters -> <string>
;;            -> <string> delimiters
;;
;; ignore-seq -> terminal
;;            -> terminal delimiters
;;
;; terminal   -> <string>
;;            -> :regex <string>
;;            -> :keyword <string>
;;            -> <builtin-terminals>

(export
  (defmacro #&custom
    custom-quote :s-exp -> "#quote'" *s-exp* => custom (list 'quote $1)
  ))

(export
  (defmacro #&comment
    :ignore :regex #r"/"/\*\*/|/\*.*\*/"/"
    :delim "/*"))

(export
  (defmacro test-replacement 'foobar))
